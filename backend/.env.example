# Copy to backend/.env for local overrides (never commit .env)

APP_NAME=document-processing-service
DEBUG=true

# Paths relative to repo root when running from backend/ with defaults,
# or set absolute paths as needed.
STORAGE_ROOT=../storage
MAX_UPLOAD_BYTES=10485760

# Comma-separated origins for CORS (frontend later)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
